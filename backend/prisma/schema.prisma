// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
  VERIFY_MOBILE
  RESET_PASSWORD
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum RefreshTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum LoginStatus {
  SUCCESS
  FAILED
  LOGOUT
}

enum LoginMethod {
  EMAIL_OTP
  WHATSAPP_OTP
}

enum PlanType {
  INTERNAL
  TRIAL
  PAID
  LIFETIME
}

enum BillingCycle {
  NONE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum UserType {
  PLATFORM_OWNER
  COMPANY_ADMIN
  EMPLOYEE
  VENDOR
  CLIENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrganizationUnitType {
  HEAD_OFFICE
  REGION
  BRANCH
  OFFICE
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCER
}

// USER MODEL START
model User {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  // Tenant Relation
  companyId BigInt?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  //roleId     BigInt?
  //employeeId BigInt?

  // Login
  email  String? @unique
  mobile String? @unique

  passwordHash String?

  // Profile
  displayName String?

  profilePhoto String?

  // Verification
  emailVerified  Boolean @default(false)
  mobileVerified Boolean @default(false)

  userType UserType @default(PLATFORM_OWNER)

  // Status
  status UserStatus @default(PENDING)

  // Activity
  lastLoginAt  DateTime?
  lastActiveAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations (abhi comment me)
  // company  Company?   @relation(...)
  // role     Role?      @relation(...)
  // employee Employee?  @relation(...)

  otps          Otp[]
  refreshTokens RefreshToken[]
  loginHistory  LoginHistory[]

  @@index([companyId])
  @@index([status])
  @@map("users")
}

// USER MODEL END

// OTP MODEL 
model Otp {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  userId BigInt?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  receiver String

  otpHash String

  purpose OtpPurpose

  channel OtpChannel

  status OtpStatus @default(PENDING)

  attemptCount Int @default(0)

  maxAttempts Int @default(5)

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([receiver])
  @@index([purpose])
  @@index([status])
  @@map("otps")
}

// OTP MODEL END

// REFRESH TOKEN MODEL
model RefreshToken {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  deviceId   String?
  deviceName String?

  ipAddress String?
  userAgent String?

  status RefreshTokenStatus @default(ACTIVE)

  expiresAt DateTime

  lastUsedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// REFRESH TOKEN MODEL END

// LOGIN HISTORY MODEL
model LoginHistory {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  userId BigInt?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  loginMethod LoginMethod

  status LoginStatus

  receiver String

  ipAddress String?

  userAgent String?

  deviceId String?

  deviceName String?

  loginAt DateTime?

  logoutAt DateTime?

  failureReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([receiver])
  @@index([status])
  @@map("login_history")
}

// LOGIN HISTORY MODEL END

// Company MODULE
model Company {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String

  code String @unique

  email String? @unique

  mobile String? @unique

  logo String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                User[]
  companySubscriptions CompanySubscription[]
  organizationUnits    OrganizationUnit[]
  roles                Role[]
  clients              Client[]
  projects             Project[]
  designations         Designation[]
  departments          Department[]
  employees            Employee[]

  @@index([status])
  @@map("companies")
}

// END Company Module

//Feature Module Start

model Module {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String
  code String @unique

  description String?

  icon String?

  route String?

  sortOrder Int @default(0)

  isSystem Boolean @default(true)

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subscriptionPlanModules SubscriptionPlanModule[]

  @@index([status])
  @@map("modules")
}

//Feature Module End

//Subscription Plan START

model SubscriptionPlan {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String

  code String @unique

  description String?

  planType PlanType

  billingCycle BillingCycle

  price Decimal @db.Decimal(10, 2)

  trialDays Int @default(0)

  durationInDays Int?

  maxUsers Int?

  maxBranches Int?

  maxProjects Int?

  sortOrder Int @default(0)

  isPublic Boolean @default(true)

  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companySubscriptions    CompanySubscription[]
  subscriptionPlanModules SubscriptionPlanModule[]

  @@index([status])
  @@index([planType])
  @@index([isPublic])
  @@map("subscription_plans")
}

// End Subsription Plan

//Subscription Plan Module Start

model SubscriptionPlanModule {
  id BigInt @id @default(autoincrement())

  subscriptionPlanId BigInt

  moduleId BigInt

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  module Module @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([subscriptionPlanId, moduleId])
  @@index([subscriptionPlanId])
  @@index([moduleId])
  @@map("subscription_plan_modules")
}

//Subscription Plan Module End

// Company Subscription Start
model CompanySubscription {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id])

  subscriptionPlanId BigInt
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  startDate DateTime

  endDate DateTime?

  amount Decimal? @db.Decimal(10, 2)

  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([subscriptionPlanId])
  @@map("company_subscriptions")
}

//Company Subscription End

//Organisation unit schema
model OrganizationUnit {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id])

  parentId BigInt?
  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  type OrganizationUnitType

  name String
  code String

  email  String?
  mobile String?

  addressLine1 String?
  addressLine2 String?

  city    String?
  state   String?
  country String?
  pincode String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees Employee[]

  @@index([companyId])
  @@index([parentId])
  @@index([type])
}

//End Organisation unit schema

// Role Schema

model Role {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id])

  name String
  code String

  description String?

  isSystem Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

// end Role Schema

//Permission Schema Start

model Permission {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  module      String
  name        String
  code        String  @unique
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]

  @@index([module])
}

//Permission Schema End

//Role Permission Schema Start

model RolePermission {
  id BigInt @id @default(autoincrement())

  roleId       BigInt
  permissionId BigInt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

//Role Permission Schema End

//Master schema

model State {
  id      BigInt  @id @default(autoincrement())
  uuid    String  @unique @default(uuid()) @db.Uuid
  name    String
  code    String  @unique
  gstCode String?
  status  Status  @default(ACTIVE)

  cities City[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clients  Client[]
  projects Project[]

  @@index([status])
}

model City {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  stateId BigInt
  state   State  @relation(fields: [stateId], references: [id])

  name   String
  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clients  Client[]
  projects Project[]

  @@unique([stateId, name])
  @@index([stateId])
  @@index([status])
}

//End Master Schema

//Client Schema Start

model Client {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stateId BigInt?
  state   State?  @relation(fields: [stateId], references: [id])

  cityId BigInt?
  city   City?   @relation(fields: [cityId], references: [id])

  name String
  code String

  contactName String
  mobile      String
  email       String?

  gstNumber String?
  panNumber String?

  address String?
  pincode String?

  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([stateId])
  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
}

//Client Schema End

//Project Schema Start

model Project {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId BigInt
  client   Client @relation(fields: [clientId], references: [id])

  stateId BigInt?
  state   State?  @relation(fields: [stateId], references: [id])

  cityId BigInt?
  city   City?   @relation(fields: [cityId], references: [id])

  srn  String
  name String

  address String?
  pincode String?

  startDate       DateTime?
  expectedEndDate DateTime?

  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, srn])
  @@index([companyId])
  @@index([clientId])
  @@index([stateId])
  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
}

//Project Schema End

//Designation Schema Start

model Designation {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  name String
  code String

  description String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees Employee[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@map("designations")
}

//Designaion Schema End

//Department Schema Start

model Department {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  name        String
  code        String
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees Employee[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@map("departments")
}

//Department Schema End

//Employee Schema Start

model Employee {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  employeeCode String @db.VarChar(30)

  firstName   String  @db.VarChar(100)
  lastName    String? @db.VarChar(100)
  displayName String? @db.VarChar(200)

  email  String? @db.VarChar(150)
  mobile String  @db.VarChar(20)

  gender Gender?

  organizationUnitId BigInt?
  departmentId       BigInt?
  designationId      BigInt?

  managerId BigInt?

  joiningDate DateTime?

  employmentType EmploymentType @default(FULL_TIME)

  avatarUrl String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  designation Designation? @relation(fields: [designationId], references: [id])

  manager Employee? @relation("EmployeeManager", fields: [managerId], references: [id])

  subordinates Employee[] @relation("EmployeeManager")

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@index([designationId])
  @@index([organizationUnitId])
  @@index([managerId])
  @@index([status])
  @@map("employees")
}

//Employee Schema End
