model CompanySupplier {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /**
   * Supplier global vendor ho bhi sakta hai
   * aur nahi bhi.
   * Unregistered local supplier:
   * vendorId = null
   * Registered global vendor:
   * vendorId = VendorProfile.id
   */
  vendorId BigInt?

  vendor VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /**
   * Company-specific supplier code.
   * Same global vendor ka code:
   * Company A -> SUP-001
   * Company B -> VEN-047
   */
  code String @db.VarChar(50)

  /**
   * Local supplier snapshot.
   * VendorProfile link hone ke baad bhi
   * company ki procurement history stable
   * rakhne ke liye ye data useful rahega.
   */
  name String @db.VarChar(200)

  contactName String? @db.VarChar(150)

  mobile String? @db.VarChar(20)
  email  String? @db.VarChar(150)

  gstNumber String? @db.VarChar(30)
  panNumber String? @db.VarChar(20)

  stateId BigInt?
  state   State?  @relation(fields: [stateId], references: [id], onDelete: Restrict)

  cityId BigInt?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  address String?
  pincode String? @db.VarChar(10)

  /**
   * Company-private commercial terms.
   */
  paymentTermsDays Int?

  creditLimit Decimal? @db.Decimal(14, 2)

  isPreferred Boolean @default(false)

  source CompanySupplierSource @default(MANUAL)

  status CompanySupplierStatus @default(ACTIVE)

  /**
   * Global VendorProfile se kab link hua.
   */
  linkedAt DateTime?

  remarks String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invitations VendorInvitation[]

  @@unique([companyId, code])
  /**
   * Same global vendor ek company me
   * duplicate supplier nahi banega.
   * vendorId nullable hai, therefore
   * unregistered local suppliers multiple
   * ho sakte hain.
   */
  @@unique([companyId, vendorId])
  @@index([companyId])
  @@index([vendorId])
  @@index([name])
  @@index([gstNumber])
  @@index([email])
  @@index([stateId])
  @@index([cityId])
  @@index([source])
  @@index([status])
  @@index([isPreferred])
  @@index([deletedAt])
  @@map("company_suppliers")
}

model VendorInvitation {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companySupplierId BigInt

  companySupplier CompanySupplier @relation(fields: [companySupplierId], references: [id], onDelete: Cascade)

  /**
   * Invite kis user ne bheja.
   */
  invitedByUserId BigInt

  invitedByUser User @relation("VendorInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  /**
   * Invite target.
   * Email/mobile me se at least one
   * backend validation se required karenge.
   */
  email  String? @db.VarChar(150)
  mobile String? @db.VarChar(20)

  /**
   * Raw invite token DB me store nahi karna.
   * Sirf hash store hoga.
   */
  tokenHash String @unique @db.VarChar(255)

  status VendorInvitationStatus @default(PENDING)

  expiresAt DateTime

  acceptedAt DateTime?

  /**
   * Invite accept hone ke baad linked
   * global vendor.
   */
  vendorId BigInt?

  vendor VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /**
   * Kis actual User ne invitation accept ki.
   */
  acceptedByUserId BigInt?

  acceptedByUser User? @relation("VendorInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companySupplierId])
  @@index([invitedByUserId])
  @@index([vendorId])
  @@index([acceptedByUserId])
  @@index([email])
  @@index([mobile])
  @@index([status])
  @@index([expiresAt])
  @@map("vendor_invitations")
}

