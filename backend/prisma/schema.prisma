// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
  VERIFY_MOBILE
  RESET_PASSWORD
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum RefreshTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum LoginStatus {
  SUCCESS
  FAILED
  LOGOUT
}

enum LoginMethod {
  EMAIL_OTP
  WHATSAPP_OTP
}

enum PlanType {
  INTERNAL
  TRIAL
  PAID
  LIFETIME
}

enum BillingCycle {
  NONE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum UserType {
  PLATFORM_OWNER
  COMPANY_ADMIN
  EMPLOYEE
  VENDOR
  CLIENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrganizationUnitType {
  HEAD_OFFICE
  REGION
  BRANCH
  OFFICE
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCER
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETION_REQUESTED
  COMPLETED
  CANCELLED
}

enum ProjectTaskReportType {
  PROGRESS
  BLOCKER
  NOTE
  COMPLETION
}

enum ProjectTaskAttachmentType {
  IMAGE
  DOCUMENT
}

enum ProjectTaskWorkSessionStatus {
  OPEN
  CLOSED
}

enum ProjectTaskCompletionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PermissionType {
  PLATFORM
  COMPANY
}

enum PermissionScope {
  OWN
  TEAM
  ORGANIZATION_UNIT
  PROJECT
  COMPANY
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorMarketplaceStatus {
  PRIVATE
  PENDING
  PUBLISHED
  SUSPENDED
}

enum VendorOnboardingSource {
  SELF_REGISTRATION
  COMPANY_INVITE
  PLATFORM_CREATED
}

enum VendorUserRole {
  OWNER
  ADMIN
  SALES
  ACCOUNTS
  OPERATIONS
  USER
}

enum VendorServiceAreaType {
  NATIONAL
  STATE
  CITY
  PINCODE
  RADIUS
}

enum CompanySupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanySupplierSource {
  MANUAL
  GLOBAL_VENDOR
  COMPANY_INVITE
}

enum VendorInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum VendorPlanType {
  FREE
  PAID
  LIFETIME
}

enum VendorSubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum VendorSubscriptionBillingCycle {
  NONE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum VendorVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum VendorDocumentType {
  PAN
  GST_CERTIFICATE
  UDYAM
  BUSINESS_REGISTRATION
  ADDRESS_PROOF
  BANK_PROOF
  CANCELLED_CHEQUE
  OTHER
}

enum VendorDocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VendorBankAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  INACTIVE
}

enum VendorTaxRegistrationStatus {
  PENDING
  VERIFIED
  REJECTED
  INACTIVE
}

enum VendorContactType {
  OWNER
  SALES
  ACCOUNTS
  PURCHASE
  DISPATCH
  SUPPORT
  OTHER
}

enum VendorAddressType {
  REGISTERED_OFFICE
  BILLING
  WAREHOUSE
  BRANCH
  OTHER
}

// USER MODEL START
model User {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  // Tenant Relation
  companyId BigInt?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  employeeId BigInt?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  roleId BigInt?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  platformRoleId BigInt?
  platformRole   PlatformRole? @relation(fields: [platformRoleId], references: [id], onDelete: SetNull)

  // Login
  email  String? @unique
  mobile String? @unique

  passwordHash String?

  // Profile
  displayName String?

  profilePhoto String?

  // Verification
  emailVerified  Boolean @default(false)
  mobileVerified Boolean @default(false)

  userType UserType @default(PLATFORM_OWNER)

  // Status
  status UserStatus @default(PENDING)

  // Activity
  lastLoginAt  DateTime?
  lastActiveAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  otps                     Otp[]
  refreshTokens            RefreshToken[]
  loginHistory             LoginHistory[]
  extraPermissions         UserPermission[]
  taskReports              ProjectTaskReport[]
  taskWorkSessions         ProjectTaskWorkSession[]
  requestedTaskCompletions ProjectTaskCompletionRequest[] @relation("TaskCompletionRequestedBy")
  reviewedTaskCompletions  ProjectTaskCompletionRequest[] @relation("TaskCompletionReviewedBy")

  vendorMemberships VendorUser[]

  sentVendorInvitations     VendorInvitation[] @relation("VendorInvitationInvitedBy")
  acceptedVendorInvitations VendorInvitation[] @relation("VendorInvitationAcceptedBy")

  reviewedVendorVerifications VendorVerification[] @relation("VendorVerificationReviewedBy")
  reviewedVendorDocuments     VendorDocument[]     @relation("VendorDocumentReviewedBy")

  @@index([companyId])
  @@index([employeeId])
  @@index([roleId])
  @@index([platformRoleId])
  @@index([status])
  @@map("users")
}

// USER MODEL END

// OTP MODEL 
model Otp {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  userId BigInt?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  receiver String

  otpHash String

  purpose OtpPurpose

  channel OtpChannel

  status OtpStatus @default(PENDING)

  attemptCount Int @default(0)

  maxAttempts Int @default(5)

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([receiver])
  @@index([purpose])
  @@index([status])
  @@map("otps")
}

// OTP MODEL END

// REFRESH TOKEN MODEL
model RefreshToken {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  deviceId   String?
  deviceName String?

  ipAddress String?
  userAgent String?

  status RefreshTokenStatus @default(ACTIVE)

  expiresAt DateTime

  lastUsedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// REFRESH TOKEN MODEL END

// LOGIN HISTORY MODEL
model LoginHistory {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  userId BigInt?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  loginMethod LoginMethod

  status LoginStatus

  receiver String

  ipAddress String?

  userAgent String?

  deviceId String?

  deviceName String?

  loginAt DateTime?

  logoutAt DateTime?

  failureReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([receiver])
  @@index([status])
  @@map("login_history")
}

// LOGIN HISTORY MODEL END

// Company MODULE
model Company {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String

  code String @unique

  email String? @unique

  mobile String? @unique

  logo String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                         User[]
  companySubscriptions          CompanySubscription[]
  organizationUnits             OrganizationUnit[]
  roles                         Role[]
  clients                       Client[]
  projects                      Project[]
  projectCategories             ProjectCategory[]
  designations                  Designation[]
  departments                   Department[]
  employees                     Employee[]
  projectRoles                  ProjectRole[]
  projectMembers                ProjectMember[]
  projectTasks                  ProjectTask[]
  projectTaskReports            ProjectTaskReport[]
  projectTaskWorkSessions       ProjectTaskWorkSession[]
  projectTaskCompletionRequests ProjectTaskCompletionRequest[]

  companySuppliers  CompanySupplier[]
  vendorInvitations VendorInvitation[]

  @@index([status])
  @@map("companies")
}

// END Company Module

//Feature Module Start

model Module {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String
  code String

  description String?

  icon  String?
  route String?

  // Module Hierarchy
  parentId BigInt?
  parent   Module?  @relation("ModuleHierarchy", fields: [parentId], references: [id])
  children Module[] @relation("ModuleHierarchy")

  // UI Settings
  sortOrder Int     @default(0)
  isMenu    Boolean @default(true)
  isVisible Boolean @default(true)
  isSystem  Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  subscriptionPlanModules SubscriptionPlanModule[]

  @@index([parentId])
  @@index([sortOrder])
  @@index([status])
}

//Feature Module End

//Subscription Plan START

model SubscriptionPlan {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String

  code String @unique

  description String?

  planType PlanType

  billingCycle BillingCycle

  price Decimal @db.Decimal(10, 2)

  trialDays Int @default(0)

  durationInDays Int?

  maxUsers Int?

  maxBranches Int?

  maxProjects Int?

  sortOrder Int @default(0)

  isPublic Boolean @default(true)

  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companySubscriptions    CompanySubscription[]
  subscriptionPlanModules SubscriptionPlanModule[]

  @@index([status])
  @@index([planType])
  @@index([isPublic])
  @@map("subscription_plans")
}

// End Subsription Plan

//Subscription Plan Module Start

model SubscriptionPlanModule {
  id BigInt @id @default(autoincrement())

  subscriptionPlanId BigInt

  moduleId BigInt

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  module Module @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([subscriptionPlanId, moduleId])
  @@index([subscriptionPlanId])
  @@index([moduleId])
  @@map("subscription_plan_modules")
}

//Subscription Plan Module End

// Company Subscription Start
model CompanySubscription {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id])

  isCurrent Boolean @default(true)

  renewalDate DateTime?

  subscriptionPlanId BigInt
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  startDate DateTime

  endDate DateTime?

  amount Decimal? @db.Decimal(10, 2)

  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([subscriptionPlanId])
  @@map("company_subscriptions")
}

//Company Subscription End

//Organisation unit schema
model OrganizationUnit {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id])

  parentId BigInt?
  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  type OrganizationUnitType

  name String
  code String

  email  String?
  mobile String?

  addressLine1 String?
  addressLine2 String?

  stateId BigInt?
  state   State?  @relation(fields: [stateId], references: [id])

  cityId BigInt?
  city   City?   @relation(fields: [cityId], references: [id])

  country String?
  pincode String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments Department[]
  employees   Employee[]
  projects    Project[]

  @@index([companyId])
  @@index([parentId])
  @@index([type])
  @@index([stateId])
  @@index([cityId])
}

//End Organisation unit schema

// Role Schema

model Role {
  id BigInt @id @default(autoincrement())

  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id])

  name String
  code String

  description String?

  isSystem Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]
  users           User[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

// end Role Schema

//Permission Schema Start

model Permission {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  module      String
  name        String
  code        String  @unique
  description String?

  type PermissionType @default(COMPANY)

  allowedScopes PermissionScope[] @default([])

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  platformRolePermissions PlatformRolePermission[]

  @@index([module])
  @@index([type])
  @@index([type, module])
}

//Permission Schema End

//Role Permission Schema Start

model RolePermission {
  id BigInt @id @default(autoincrement())

  roleId       BigInt
  permissionId BigInt

  scope PermissionScope

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([scope])
}

//Role Permission Schema End

//Extra Permission Schema startDate

model UserPermission {
  id BigInt @id @default(autoincrement())

  userId BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permissionId BigInt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  scope PermissionScope

  assignedAt DateTime @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([scope])
  @@map("user_permissions")
}

//Platform Role Start

model PlatformRole {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name String
  code String @unique

  description String?

  isSystem Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]

  permissions PlatformRolePermission[]

  @@index([status])
  @@map("platform_roles")
}

model PlatformRolePermission {
  id BigInt @id @default(autoincrement())

  platformRoleId BigInt
  permissionId   BigInt

  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([platformRoleId, permissionId])
  @@index([platformRoleId])
  @@index([permissionId])
  @@map("platform_role_permissions")
}

//Platform Role End

//Extra Permission Schema End

//Master schema

model State {
  id      BigInt  @id @default(autoincrement())
  uuid    String  @unique @default(uuid()) @db.Uuid
  name    String
  code    String  @unique
  gstCode String?
  status  Status  @default(ACTIVE)

  cities            City[]
  organizationUnits OrganizationUnit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clients                Client[]
  projects               Project[]
  vendorServiceAreas     VendorServiceArea[]
  companySuppliers       CompanySupplier[]
  vendorTaxRegistrations VendorTaxRegistration[]
  vendorAddresses VendorAddress[]

  @@index([status])
}

model City {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  stateId BigInt
  state   State  @relation(fields: [stateId], references: [id])

  name   String
  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clients           Client[]
  projects          Project[]
  organizationUnits OrganizationUnit[]

  vendorServiceAreas VendorServiceArea[]
  companySuppliers   CompanySupplier[]
  vendorAddresses VendorAddress[]

  @@unique([stateId, name])
  @@index([stateId])
  @@index([status])
}

//End Master Schema

//Client Schema Start

model Client {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stateId BigInt?
  state   State?  @relation(fields: [stateId], references: [id])

  cityId BigInt?
  city   City?   @relation(fields: [cityId], references: [id])

  name String
  code String

  contactName String
  mobile      String
  email       String?

  gstNumber String?
  panNumber String?

  address String?
  pincode String?

  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([stateId])
  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
}

//Client Schema End

//Project Schema Start

model Project {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId BigInt
  client   Client @relation(fields: [clientId], references: [id])

  categoryId BigInt
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  organizationUnitId BigInt
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: SetNull)

  stateId BigInt?
  state   State?  @relation(fields: [stateId], references: [id])

  cityId BigInt?
  city   City?   @relation(fields: [cityId], references: [id])

  srn  String
  name String

  address String?
  pincode String?

  startDate       DateTime?
  expectedEndDate DateTime?

  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members ProjectMember[]
  tasks   ProjectTask[]

  @@unique([companyId, srn])
  @@index([companyId])
  @@index([categoryId])
  @@index([organizationUnitId])
  @@index([clientId])
  @@index([stateId])
  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
}

//Project Schema End

//Project Category Schema

model ProjectCategory {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)
  code String @db.VarChar(50)

  description String?

  color String? @db.VarChar(20)

  sortOrder Int @default(0)

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("project_categories")
}

//Project Category End 

//Project Role Master
model ProjectRole {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  code String @db.VarChar(50)

  description String?

  // true:
  // Project Manager
  // Service Manager
  // Account Manager
  //
  // false:
  // Developer
  // Engineer
  // Technician
  isSingleAssignee Boolean @default(false)

  // Optional dependency
  //
  // Example:
  // Project Manager -> null
  // Service Manager -> Project Manager
  // Technician -> Service Manager
  requiredRoleId BigInt?

  requiredRole ProjectRole? @relation("ProjectRoleDependency", fields: [requiredRoleId], references: [id], onDelete: SetNull)

  dependentRoles ProjectRole[] @relation("ProjectRoleDependency")

  sortOrder Int @default(0)

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projectMembers ProjectMember[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([requiredRoleId])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("project_roles")
}

//Project Role Master End

//ProjectMember Assignment schema

model ProjectMember {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId BigInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId BigInt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectRoleId BigInt

  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now())

  removedAt DateTime?

  isActive Boolean @default(true)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTasks          ProjectTask[]
  taskReports            ProjectTaskReport[]
  taskWorkSessions       ProjectTaskWorkSession[]
  taskCompletionRequests ProjectTaskCompletionRequest[]

  @@index([companyId])
  @@index([projectId])
  @@index([employeeId])
  @@index([projectRoleId])
  @@index([projectId, projectRoleId])
  @@index([projectId, employeeId])
  @@index([isActive])
  @@map("project_members")
}

//End ProjectMember Assignment Schema

//Start Project Task Schema

model ProjectTask {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId BigInt
  projectId BigInt

  assignedProjectMemberId BigInt?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedProjectMember ProjectMember? @relation(fields: [assignedProjectMemberId], references: [id], onDelete: SetNull)

  title String @db.VarChar(200)

  description String?

  priority TaskPriority @default(MEDIUM)

  status ProjectTaskStatus @default(TODO)

  startDate DateTime?
  dueDate   DateTime?

  completedAt DateTime?

  remarks String?

  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reports            ProjectTaskReport[]
  workSessions       ProjectTaskWorkSession[]
  completionRequests ProjectTaskCompletionRequest[]

  @@index([companyId])
  @@index([projectId])
  @@index([assignedProjectMemberId])
  @@index([priority])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("project_tasks")
}

// End Project Task Schema

// ProjectTaskReport Schema

model ProjectTaskReport {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  companyId       BigInt
  taskId          BigInt
  projectMemberId BigInt
  userId          BigInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

