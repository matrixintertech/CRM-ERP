//Vendor Schema Start
model VendorProfile {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  legalName   String  @db.VarChar(200)
  displayName String? @db.VarChar(200)

  /**
   * Primary tax/contact details.
   * Future me multi-GST / branch support ke liye
   * separate VendorTaxRegistration model add karenge.
   */
  panNumber        String? @db.VarChar(20)
  primaryGstNumber String? @db.VarChar(30)

  email  String? @db.VarChar(150)
  mobile String? @db.VarChar(20)

  website String? @db.VarChar(255)

  address String?
  pincode String? @db.VarChar(10)

  onboardingSource VendorOnboardingSource

  status VendorStatus @default(PENDING)

  marketplaceStatus VendorMarketplaceStatus @default(PRIVATE)

  isVerified Boolean @default(false)

  verifiedAt DateTime?

  remarks String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users VendorUser[]

  categories   VendorCategoryAssignment[]
  serviceAreas VendorServiceArea[]

  companySuppliers CompanySupplier[]
  invitations      VendorInvitation[]
  subscriptions    VendorSubscription[]

  verifications    VendorVerification[]
  documents        VendorDocument[]
  taxRegistrations VendorTaxRegistration[]
  bankAccounts     VendorBankAccount[]

  contacts  VendorContact[]
  addresses VendorAddress[]

  @@index([legalName])
  @@index([panNumber])
  @@index([primaryGstNumber])
  @@index([email])
  @@index([mobile])
  @@index([status])
  @@index([marketplaceStatus])
  @@index([isVerified])
  @@index([deletedAt])
  @@map("vendor_profiles")
}

